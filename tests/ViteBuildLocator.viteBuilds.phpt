<?php

declare(strict_types=1);


namespace Dakujem\Trest;

require_once __DIR__ . '/common.php';

use Dakujem\Peat\ViteBuildLocator;
use Tester\Assert;
use Tester\TestCase;

/**
 * This test runs the build locator against manifests generated by real builds of Vite 2 through 8.
 * The fixtures `manifest.vite<version>.json` are generated from the sources in `tests/vite`, see `tests/vite/readme.md`.
 *
 * The build has three entries:
 * - `src/main.js` imports a shared chunk with its own CSS, has its own CSS and an image, and imports `src/lazy.js` dynamically
 * - `src/other.js` imports the shared chunk only
 * - `src/standalone.css` is a CSS-only entry
 *
 * Expected file names are read from the manifest, so the fixtures can be regenerated without changing this test.
 *
 * @author Andrej Rypak (dakujem) <xrypak@gmail.com>
 */
class _ViteBuildsTest extends TestCase
{
    public function versions(): array
    {
        return [['2'], ['3'], ['4'], ['5'], ['6'], ['7'], ['8']];
    }

    /**
     * @dataProvider versions
     */
    public function testEntryWithSharedChunk(string $version)
    {
        $m = $this->manifest($version);
        $main = $m['src/main.js'];
        $shared = $m[$this->sharedChunkKey($m)];

        $asset = $this->locator($version)->entry('src/main.js');
        Assert::same(
            ['/w/' . $main['file'], '/w/' . $shared['file']],
            $asset->modules(),
        );
        // CSS of the imported chunk first, the entry's own CSS last
        Assert::same(
            ['/w/' . $shared['css'][0], '/w/' . $main['css'][0]],
            $asset->css(),
        );
        Assert::same(['/w/' . $main['assets'][0]], $asset->assets());
        Assert::same(
            '<script type="module" src="/w/' . $main['file'] . '"></script>' . "\n" .
            '<script type="module" src="/w/' . $shared['file'] . '"></script>' . "\n" .
            '<link rel="stylesheet" href="/w/' . $shared['css'][0] . '" />' . "\n" .
            '<link rel="stylesheet" href="/w/' . $main['css'][0] . '" />',
            (string)$asset,
        );

        // the dynamically imported chunk is loaded by Vite at runtime
        $lazy = $m['src/lazy.js'];
        Assert::false(in_array('/w/' . $lazy['file'], $asset->modules(), true));
        Assert::false(in_array('/w/' . $lazy['css'][0], $asset->css(), true));
    }

    /**
     * @dataProvider versions
     */
    public function testEntryWithoutOwnCss(string $version)
    {
        $m = $this->manifest($version);
        $shared = $m[$this->sharedChunkKey($m)];

        $asset = $this->locator($version)->entry('src/other.js');
        Assert::same(
            ['/w/' . $m['src/other.js']['file'], '/w/' . $shared['file']],
            $asset->modules(),
        );
        Assert::same(['/w/' . $shared['css'][0]], $asset->css());
    }

    private function sharedChunkKey(array $manifest): string
    {
        foreach ($manifest as $key => $chunk) {
            // e.g. `_shared-DcINmvoF.js` or `_shared.82f4aa27.js`, but not the keys of the CSS files
            if (strpos($key, '_shared') === 0 && substr($chunk['file'], -3) === '.js') {
                return $key;
            }
        }
        Assert::fail('Shared chunk not found in the manifest.');
    }

    private function manifest(string $version): array
    {
        return json_decode(file_get_contents($this->manifestFile($version)), true);
    }

    private function locator(string $version): ViteBuildLocator
    {
        return new ViteBuildLocator($this->manifestFile($version), null, '/w');
    }

    private function manifestFile(string $version): string
    {
        return FIXTURES . '/manifest.vite' . $version . '.json';
    }
}

// run the test
(new _ViteBuildsTest)->run();
